## Verification Plan

### Automated Tests

```r
# 1. Install the package
remotes::install_local("h:/omicsflow_test", force = TRUE)

# 2. Load and verify exports
library(OmicsFlow)
stopifnot("omicsflow" %in% ls("package:OmicsFlow"))
stopifnot("validate_inputs" %in% ls("package:OmicsFlow"))
stopifnot("generate_metadata_templates" %in% ls("package:OmicsFlow"))

# 3. Verify internal functions are NOT exported
stopifnot(!"detect_sample_ids" %in% ls("package:OmicsFlow"))
stopifnot(!"msg_ok" %in% ls("package:OmicsFlow"))

# 4. Verify template generation works
set_omicsflow_root("h:/omicsflow_test")
generate_metadata_templates(rna = "data/realistic_cohort/rna.rds", output_dir = "results/pkg_test")

# 5. Verify subset execution works (RNA + Meth)
omicsflow(
  rna = "data/realistic_cohort/rna.rds",
  meth = "data/realistic_cohort/meth.rds",
  metadata = "data/realistic_cohort/sample_metadata.csv",
  clinical = "data/realistic_cohort/custom_clinical.tsv",
  clinical_map = "data/realistic_cohort/clinical_map.json",
  outdir = "results/pkg_run",
  mofa_iter = 20,
  render_report = FALSE
)
```

