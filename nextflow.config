// =============================================================================
// nextflow.config — OmicsFlow Master Configuration
// =============================================================================
//
// This is the root configuration file loaded automatically by Nextflow.
// It imports module-specific settings from configs/omicsflow.config.
//
// =============================================================================

// --- Import module-specific configuration ---
includeConfig 'configs/omicsflow.config'

// =============================================================================
// INPUT PARAMETERS (overridable via CLI --param)
// =============================================================================

params {

    // --- Primary Omics Inputs ---
    rna         = null          // Path to RNA-seq expression RDS
    meth        = null          // Path to Methylation beta-value RDS
    cnv         = null          // Path to CNV segment data RDS
    snv         = null          // Path to SNV mutation data RDS

    // --- Auxiliary Inputs ---
    clinical    = null          // Path to Clinical data TSV
    cross_react = null          // Path to cross-reactive probes CSV
    gene_coords = null          // Path to Ensembl gene coordinates cache RDS
    metadata    = null          // Path to Universal Metadata CSV
    clinical_map = null         // Path to clinical column mapping JSON (optional)
    validation_keywords = null  // Path to enrichment validation keywords or comma-separated string (optional)

    // --- Output ---
    outdir      = 'results'     // Root output directory

    // --- Module Parameters (see configs/omicsflow.config for defaults) ---
    // RNA preprocessing
    rna_ntop     = 2000
    rna_cor_low  = 0.75
    rna_cor_high = 0.895

    // Methylation preprocessing
    meth_ntop    = 5000

    // CNV preprocessing
    cnv_ntop     = 5000

    // SNV preprocessing
    snv_freq     = 0.02
    snv_topn     = 3000

    // Integration (MOFA+)
    mofa_factors = 15
    mofa_iter    = 1000

    // Machine Learning
    ml_mofa_prefilter  = 300
    ml_final_features  = 100
    ml_train_ratio     = 0.80
}

// =============================================================================
// PROCESS CONFIGURATION
// =============================================================================

process {

    // --- Default settings for all processes ---
    errorStrategy  = 'retry'
    maxRetries     = 2
    maxErrors      = '-1'

    // --- Resource labels ---
    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }

    withLabel: 'process_medium' {
        cpus   = 4
        memory = '16 GB'
        time   = '4h'
    }

    withLabel: 'process_high' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = '64 GB'
        time   = '24h'
    }
}

// =============================================================================
// EXECUTION PROFILES
// =============================================================================

profiles {

    // --- Standard local execution ---
    standard {
        process.executor = 'local'
    }

    // --- Docker container execution ---
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        process.container  = 'omicsflow:1.0.0'
    }

    // --- Singularity container execution (HPC-friendly) ---
    singularity {
        singularity.enabled   = true
        singularity.autoMounts = true
        process.container     = 'docker://omicsflow:1.0.0'
    }

    // --- HPC SLURM cluster ---
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        process.clusterOptions = '--account=omicsflow'
    }

    // --- HPC SLURM + Docker ---
    docker_slurm {
        docker.enabled     = true
        process.container  = 'omicsflow:1.0.0'
        process.executor   = 'slurm'
        process.queue      = 'normal'
        process.clusterOptions = '--account=omicsflow'
    }

    // --- HPC SLURM + Singularity ---
    singularity_slurm {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://omicsflow:1.0.0'
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = '--account=omicsflow'
    }

    // --- HPC PBS/Torque cluster ---
    pbs {
        process.executor = 'pbs'
        process.queue    = 'batch'
    }

    // --- Conda environment ---
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/envs/omicsflow.yml"
    }

    // --- Test profile (minimal resources for CI/CD) ---
    test {
        process {
            withLabel: 'process_low' {
                cpus   = 1
                memory = '2 GB'
                time   = '30m'
            }
            withLabel: 'process_medium' {
                cpus   = 2
                memory = '8 GB'
                time   = '2h'
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = '16 GB'
                time   = '6h'
            }
            withLabel: 'process_high_memory' {
                cpus   = 4
                memory = '32 GB'
                time   = '12h'
            }
        }
    }
}

// =============================================================================
// REPORTING & LOGGING
// =============================================================================

// --- Timeline report ---
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

// --- Execution report ---
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

// --- Trace file (TSV for programmatic analysis) ---
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,env,workdir,script,scratch,error_action'
}

// --- DAG visualization ---
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}

// =============================================================================
// MANIFEST
// =============================================================================

manifest {
    name            = 'OmicsFlow'
    author          = 'Abdullah Ibrahim Ali'
    homePage        = 'https://github.com/Abdullah-I-Ali/omicsflow'
    description     = 'Modular Multi-Omics Preprocessing, Integration, ML, and Enrichment Framework'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
