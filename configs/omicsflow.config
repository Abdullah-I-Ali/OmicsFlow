// =============================================================================
// configs/omicsflow.config — OmicsFlow Module-Specific Configuration
// =============================================================================
//
// This file documents the scientific parameters used by each R module.
// All values here match the validated defaults from the frozen R codebase.
// Override via CLI: nextflow run main.nf --rna_ntop 3000
//
// IMPORTANT: These parameters control ONLY orchestration-level behavior.
//            Scientific logic is entirely encapsulated within the R modules.
//
// =============================================================================

params {

    // =========================================================================
    // RNA-seq Preprocessing (modules/rna/preprocess_rna.R)
    // =========================================================================
    // --n-top       Number of top variable genes for MOFA integration
    // --cor-low     Lower Pearson correlation threshold for outlier detection
    // --cor-high    Upper Pearson correlation threshold for outlier detection
    rna_ntop     = 2000
    rna_cor_low  = 0.75
    rna_cor_high = 0.895

    // =========================================================================
    // DNA Methylation Preprocessing (modules/methylation/preprocess_meth.R)
    // =========================================================================
    // --n-top       Number of top variable CpG probes for MOFA integration
    meth_ntop    = 5000

    // =========================================================================
    // CNV Preprocessing (modules/cnv/preprocess_cnv.R)
    // =========================================================================
    // --ntop        Number of top variable genes to retain after aggregation
    cnv_ntop     = 5000

    // =========================================================================
    // SNV Preprocessing (modules/snv/preprocess_snv.R)
    // =========================================================================
    // --freq        Minimum mutation frequency threshold (fraction)
    // --topn        Maximum number of genes to retain
    snv_freq     = 0.02
    snv_topn     = 3000

    // =========================================================================
    // MOFA+ Integration (modules/integration/run_integration.R)
    // =========================================================================
    // --factors     Number of latent factors to learn
    // --iter        Maximum training iterations
    mofa_factors = 15
    mofa_iter    = 1000

    // =========================================================================
    // Machine Learning (modules/ml/run_ml.R)
    // =========================================================================
    // --mofa_prefilter   Top genes by MOFA weight for biological pre-filter
    // --final_features   Top genes by variance on training set (zero leakage)
    // --train_ratio      Train/Test split ratio
    ml_mofa_prefilter  = 300
    ml_final_features  = 100
    ml_train_ratio     = 0.80
}
